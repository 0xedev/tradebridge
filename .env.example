# TradeBridge Configuration

# Environment
NODE_ENV=development
LOG_LEVEL=info

# Server
PORT=3000
HOST=0.0.0.0

# Trading Configuration
PAPER_TRADING=true
INITIAL_CAPITAL=10000

# Risk Management
MAX_DAILY_LOSS_PERCENT=5
MAX_DRAWDOWN_PERCENT=20
POSITION_SIZE_PERCENT=2

# Exchange API Keys (Example: Binance)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=true

# Alpaca (Stocks/Crypto)
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET=your_alpaca_secret_here
ALPACA_PAPER=true

# OANDA (Forex)
OANDA_API_KEY=your_oanda_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_PRACTICE=true

# Database
REDIS_URL=redis://localhost:6379
POSTGRES_URL=postgresql://user:password@localhost:5432/tradebridge
MONGODB_URL=mongodb://localhost:27017/tradebridge
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your_influxdb_token_here
INFLUXDB_ORG=tradebridge
INFLUXDB_BUCKET=market_data

# Telegram Bot (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Data Sources
POLYGON_API_KEY=your_polygon_api_key_here
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key_here

# AI/ML Services
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
